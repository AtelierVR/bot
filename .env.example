# Copy to `.env` and adjust values.

# Instance to connect to (id@server)
NOX_INSTANCE=ab195342@hactazia.fr

# Mode: 'listen' (receive + play voice) or 'play' (send an opus file)
NOX_MODE=listen

# Bot index that listens (MODE=listen)
NOX_LISTEN_ID=0

# Opus file to send (MODE=play) — path inside the container
#NOX_PLAY_FILE=/app/audio/slime.opus

# Connect as a regular user (skips AUTHORIZE_BOT check)
NOX_HUMAN=1

# Number of bots / movement mode
NOX_COUNT=1
NOX_MOVEMENT=none

# Log level
NOX_RUST_LOG=info,noxbot=debug,noxrelay=info,nox_api=debug
